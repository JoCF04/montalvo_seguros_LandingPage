@media (min-width: 860px) {
  .nav-toggle {
    display: none;
  }

  .nav-menu {
    position: static;
    background: none;
    flex-direction: row;
    align-items: center;
    padding: 0;
    transform: none;
    gap: 2rem;
  }

  .nav-link {
    font-size: 1rem;
    font-family: var(--font-cuerpo);
    font-weight: 500;
    color: var(--azul-marino);
  }

  .nav-link:hover {
    color: var(--azul-marca);
  }

  .nav-cta {
    margin-top: 0;
    padding: 0.6rem 1.3rem;
    font-size: 0.95rem;
  }

  .hero-mark {
    display: block;
    position: absolute;
    right: -60px;
    top: 50%;
    transform: translateY(-50%);
    width: 46%;
    max-width: 560px;
    z-index: 1;
  }

  .hero-inner {
    grid-template-columns: 1.15fr 0.85fr;
    min-height: 560px;
    padding-top: 5rem;
    padding-bottom: 5rem;
  }
}
