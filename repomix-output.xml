<file path="assets/css/styles.css">
/* ==========================================================================
   Andrés Montalvo Chero — Corredor de Seguros
   ========================================================================== */

:root {
  /* Paleta de marca */
  --azul-marca: #0A3E84;
  --azul-marino: #06264F;
  --hueso: #F7F5F0;
  --verde-whatsapp: #25D366;
  --verde-whatsapp-hover: #1EBE59;
  --naranja-marca: #E8871E;
  --texto-oscuro: #1F2430;
  --blanco: #FFFFFF;
  --error: #B3261E;

  /* Tipografía */
  --font-titulares: 'Fraunces', Georgia, serif;
  --font-cuerpo: 'Work Sans', Arial, sans-serif;

  /* Layout */
  --container-max: 1180px;
  --container-pad: 1.5rem;
  --radius-sm: 6px;
  --radius-md: 10px;

  /* Transiciones */
  --ease: cubic-bezier(0.4, 0, 0.2, 1);
}

/* --------------------------------------------------------------------------
   Reset y base
   -------------------------------------------------------------------------- */

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: var(--font-cuerpo);
  color: var(--texto-oscuro);
  background: var(--hueso);
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

img {
  max-width: 100%;
  display: block;
}

a {
  color: inherit;
  text-decoration: none;
}

ul,
dl {
  margin: 0;
  padding: 0;
  list-style: none;
}

dd {
  margin: 0;
}

h1,
h2,
h3 {
  font-family: var(--font-titulares);
  color: var(--azul-marino);
  margin: 0;
  line-height: 1.15;
}

p {
  margin: 0;
}

button {
  font-family: inherit;
  cursor: pointer;
}

.skip-link {
  position: absolute;
  left: -9999px;
  top: 0;
  background: var(--azul-marca);
  color: var(--blanco);
  padding: 0.75rem 1.25rem;
  z-index: 200;
}

.skip-link:focus {
  left: 1rem;
  top: 1rem;
}

:focus-visible {
  outline: 2px solid var(--naranja-marca);
  outline-offset: 2px;
}

.section-inner {
  max-width: var(--container-max);
  margin: 0 auto;
  padding: 4.5rem var(--container-pad);
}

.section-head {
  max-width: 42rem;
  margin-bottom: 2.75rem;
}

.section-head h2 {
  font-size: clamp(1.9rem, 4vw, 2.6rem);
  font-weight: 600;
  margin-bottom: 0.85rem;
}

.section-head p {
  font-size: 1.05rem;
  color: #3A4258;
}

/* --------------------------------------------------------------------------
   Header
   -------------------------------------------------------------------------- */

.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(247, 245, 240, 0.98);
  border-bottom: 1px solid rgba(6, 38, 79, 0.1);
}

.header-inner {
  max-width: var(--container-max);
  margin: 0 auto;
  padding: 0.75rem var(--container-pad);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.brand-logo {
  height: 46px;
  width: auto;
}

.nav-toggle {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  width: 42px;
  height: 42px;
  background: none;
  border: none;
  padding: 0;
  z-index: 110;
}

.nav-toggle span {
  display: block;
  height: 2px;
  width: 26px;
  margin: 0 auto;
  background: var(--azul-marino);
  transition: transform 0.25s var(--ease), opacity 0.2s var(--ease);
}

.nav-toggle[aria-expanded="true"] span:nth-child(1) {
  transform: translateY(7px) rotate(45deg);
}

.nav-toggle[aria-expanded="true"] span:nth-child(2) {
  opacity: 0;
}

.nav-toggle[aria-expanded="true"] span:nth-child(3) {
  transform: translateY(-7px) rotate(-45deg);
}

.nav-menu {
  position: fixed;
  inset: 0;
  top: 0;
  background: var(--azul-marino);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 1.75rem;
  padding: 2rem 2rem;
  transform: translateX(100%);
  transition: transform 0.35s var(--ease);
  z-index: 105;
}

.nav-menu.is-open {
  transform: translateX(0);
}

.nav-link {
  font-size: 1.5rem;
  font-family: var(--font-titulares);
  color: var(--hueso);
}

.nav-cta {
  margin-top: 1rem;
  background: var(--verde-whatsapp);
  color: var(--azul-marino);
  font-weight: 600;
  padding: 0.7rem 1.4rem;
  border-radius: var(--radius-sm);
}

/* --------------------------------------------------------------------------
   Hero
   -------------------------------------------------------------------------- */

.hero {
  background: var(--azul-marca);
  overflow: hidden;
  position: relative;
}

.hero-inner {
  max-width: var(--container-max);
  margin: 0 auto;
  padding: 4rem var(--container-pad) 3.5rem;
  display: grid;
  grid-template-columns: 1fr;
  align-items: center;
  position: relative;
}

.hero-copy {
  position: relative;
  z-index: 2;
}

.hero-eyebrow {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  color: var(--hueso);
  font-size: 1.05rem;
  font-weight: 500;
  margin-bottom: 1.1rem;
  opacity: 0;
  animation: entrada 0.7s var(--ease) forwards;
  animation-delay: 0.05s;
}

.eyebrow-mark {
  width: 26px;
  height: 3px;
  background: var(--naranja-marca);
  display: inline-block;
}

.hero-title {
  font-size: clamp(2.3rem, 6vw, 3.6rem);
  font-weight: 600;
  color: var(--hueso);
  max-width: 15ch;
  opacity: 0;
  animation: entrada 0.7s var(--ease) forwards;
  animation-delay: 0.18s;
}

.hero-subtitle {
  margin-top: 1.5rem;
  max-width: 34rem;
  color: rgba(247, 245, 240, 0.85);
  font-size: 1.08rem;
  opacity: 0;
  animation: entrada 0.7s var(--ease) forwards;
  animation-delay: 0.32s;
}

.btn-whatsapp {
  margin-top: 2.2rem;
  display: inline-flex;
  align-items: center;
  gap: 0.65rem;
  background: var(--verde-whatsapp);
  color: var(--azul-marino);
  font-weight: 600;
  font-size: 1.02rem;
  padding: 0.95rem 1.75rem;
  border-radius: var(--radius-sm);
  opacity: 0;
  animation: entrada 0.7s var(--ease) forwards;
  animation-delay: 0.46s;
  transition: background 0.2s var(--ease), transform 0.2s var(--ease);
}

.btn-whatsapp:hover {
  background: var(--verde-whatsapp-hover);
  transform: translateY(-2px);
}

.icon-whatsapp {
  width: 22px;
  height: 22px;
  flex-shrink: 0;
}

.hero-mark {
  display: none;
}

.hero-horse {
  width: 100%;
  opacity: 0;
  animation: entradaHorse 0.9s var(--ease) forwards;
  animation-delay: 0.25s;
}

@keyframes entrada {
  from {
    opacity: 0;
    transform: translateY(16px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes entradaHorse {
  from {
    opacity: 0;
    transform: scale(0.94);
  }
  to {
    opacity: 0.9;
    transform: scale(1);
  }
}

