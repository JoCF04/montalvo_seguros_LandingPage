    column-gap: 3rem;
  }

  .nosotros-inner {
    grid-template-columns: auto 1fr;
    gap: 4rem;
  }

  .contacto-grid {
    grid-template-columns: 1.1fr 0.9fr;
  }

  .footer-inner {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
